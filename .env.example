# Provider Options: openai | google | ollama
PROVIDER=openai

# Model names:
# OpenAI: gpt-4o | gpt-4o-mini
# Google: gemini-1.5-pro | gemini-2.0-flash
# Ollama: mistral:latest | llama3 | codellama
MODEL=gpt-4o-mini

# OpenAI API Key (get from: <https://platform.openai.com/api-keys>)
OPENAI_API_KEY=

# Google Gemini API Key (get from: <https://aistudio.google.com/apikey>)
GOOGLE_API_KEY=

# Ollama Host (only for local Ollama)
OLLAMA_HOST=http://localhost:11434

# Optional Settings
LOG_LEVEL=INFO
OUTPUT_DIR=output

# Playwright — playwright-project/playwright.config.ts loads this file from the repo root (dotenv).
# Example public demo: https://automationexercise.com  |  local app: http://localhost:3000
PW_BASE_URL=http://localhost:3000

# Optional: playwright-smart-reporter AI tier — see https://www.npmjs.com/package/playwright-smart-reporter
# SMART_REPORTER_LICENSE_KEY=

# Timeout (seconds) — httpx fallback when a provider does not set a custom client timeout
TIMEOUT=60
# OpenAI / Google: max time to read the response body (codegen and long answers)
LLM_READ_TIMEOUT=300
# Ollama: max time to wait for response body (model load + generation can exceed TIMEOUT)
OLLAMA_READ_TIMEOUT=600