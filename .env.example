# ⚠️  IMPORTANT: NEVER commit .env with real secrets. Copy from .env.example and edit locally.
# See .gitignore: .env is excluded; only .env.example should be tracked.

# Provider Options: openai | google | ollama
PROVIDER=openai

# Model names:
# OpenAI: gpt-4o | gpt-4o-mini
# Google: gemini-1.5-pro | gemini-2.0-flash
# Ollama: mistral:latest | llama3 | codellama
MODEL=gpt-4o-mini

# OpenAI API Key (get from: https://platform.openai.com/api-keys)
# WARNING: Never commit this. Set via environment variable in production.
OPENAI_API_KEY=

# Google Gemini API Key (get from: https://aistudio.google.com/apikey)
# WARNING: Never commit this. Set via environment variable in production.
GOOGLE_API_KEY=

# Ollama Host (only for local Ollama)
OLLAMA_HOST=http://localhost:11434

# Optional Settings
LOG_LEVEL=INFO
OUTPUT_DIR=output

# Timeout (seconds) — httpx: cloud API calls
TIMEOUT=60
# Ollama: max time to wait for response body (model load + generation can exceed TIMEOUT)
OLLAMA_READ_TIMEOUT=600

# ────────────────────────────────────────────────────────────────────────────
# Playwright test settings (required for BDD automation in playwright-project/)
# ────────────────────────────────────────────────────────────────────────────

# Base URL for the automationexercise.com test site
PW_BASE_URL=https://automationexercise.com

# Test account credentials (required for logged-in scenarios like TC-001, TC-003)
# WARNING: Never commit real credentials. Use test accounts only.
# Create a dedicated test account for automation; do NOT use your personal account.
PW_TEST_EMAIL=
PW_TEST_PASSWORD=